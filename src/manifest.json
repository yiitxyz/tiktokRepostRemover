{
  "manifest_version": 3,
  "name": "TikTok Repost Remover",
  "description": "Scan, review, and selectively remove TikTok reposts using your signed-in session.",
  "version": "2.0.1",
  "author": "yiitxyz",
  "homepage_url": "https://github.com/yiitxyz/tiktok-repost-remover",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
